config camtools 'config'
	# 学号 (最大64字符)
	option student_id ''
	# 密码 (最大64字符)
	option password ''
	# 服务器地址 (格式: ip:port, 默认: 192.168.40.2:801)
	option server_address '192.168.40.2:801'
	# 服务启用状态 (0=禁用, 1=启用)
	option service_enabled '0'
	# 网络状态检测间隔 (秒, 最小值: 1, 默认: 1)
	option check_interval '1'
	# 循环保活登录间隔 (分钟, 每隔该时间无条件重新登录一次, 最小值: 1, 默认: 30)
	option relogin_interval '30'
